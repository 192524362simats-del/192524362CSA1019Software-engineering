<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kanban Board</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f4f6f9;
            margin: 0;
            padding: 25px;
        }

        h1 {
            text-align: center;
            color: #243447;
        }

        .board {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            max-width: 1200px;
            margin: 25px auto;
        }

        .column {
            background: #e7edf5;
            padding: 15px;
            border-radius: 10px;
            min-height: 350px;
        }

        .column h2 {
            text-align: center;
            font-size: 20px;
        }

        .task {
            background: white;
            padding: 15px;
            margin: 12px 0;
            border-radius: 8px;
            box-shadow: 0 2px 5px #ccc;
        }

        button {
            padding: 7px 10px;
            margin: 4px 2px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            background: #2563eb;
            color: white;
        }

        button:hover {
            background: #1746a2;
        }

        .add-task {
            text-align: center;
            margin: 20px;
        }

        input, select {
            padding: 10px;
            margin: 5px;
        }

        @media (max-width: 700px) {
            .board {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

<h1>Kanban Task Management Board</h1>

<div class="add-task">
    <input type="text" id="taskInput"
           placeholder="Enter a new task">

    <select id="taskStatus">
        <option value="todo">To Do</option>
        <option value="progress">In Progress</option>
        <option value="done">Done</option>
    </select>

    <button onclick="addTask()">Add Task</button>
</div>

<div class="board">

    <div class="column">
        <h2>To Do</h2>
        <div id="todo"></div>
    </div>

    <div class="column">
        <h2>In Progress</h2>
        <div id="progress"></div>
    </div>

    <div class="column">
        <h2>Done</h2>
        <div id="done"></div>
    </div>

</div>

<script>
    let taskId = 6;

    const tasks = [
        {id: 1, title: "Design Login Page", status: "todo"},
        {id: 2, title: "Prepare Documentation", status: "todo"},
        {id: 3, title: "Develop Dashboard", status: "progress"},
        {id: 4, title: "Test Authentication", status: "progress"},
        {id: 5, title: "Setup Project Repository", status: "done"}
    ];

    function displayTasks() {
        ["todo", "progress", "done"].forEach(status => {
            document.getElementById(status).innerHTML = "";
        });

        tasks.forEach(task => {
            const card = document.createElement("div");
            card.className = "task";

            const title = document.createElement("strong");
            title.textContent = task.title;

            const id = document.createElement("p");
            id.textContent = "TASK-" + task.id;

            card.appendChild(title);
            card.appendChild(id);

            const statusOrder = ["todo", "progress", "done"];
            const index = statusOrder.indexOf(task.status);

            if (index > 0) {
                const back = document.createElement("button");
                back.textContent = "← Back";
                back.onclick = () => moveTask(
                    task.id, statusOrder[index - 1]
                );
                card.appendChild(back);
            }

            if (index < 2) {
                const next = document.createElement("button");
                next.textContent = "Move →";
                next.onclick = () => moveTask(
                    task.id, statusOrder[index + 1]
                );
                card.appendChild(next);
            }

            document.getElementById(task.status).appendChild(card);
        });
    }

    function addTask() {
        const input = document.getElementById("taskInput");
        const title = input.value.trim();

        if (title === "") {
            alert("Please enter a task name.");
            return;
        }

        tasks.push({
            id: taskId++,
            title: title,
            status: document.getElementById("taskStatus").value
        });

        input.value = "";
        displayTasks();
    }

    function moveTask(id, newStatus) {
        const task = tasks.find(task => task.id === id);

        if (task) {
            task.status = newStatus;
            displayTasks();
        }
    }

    displayTasks();
</script>

</body>
</html>
